rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /sessions/{sessionId}/{allPaths=**} {
      allow read, write: if request.auth != null; // Simplificado. Idealmente verificar que el usuario pertenece a la sesión.
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email != null; // Agentes
    }
  }
}
